{
  "name": "@trinker/vitest",
  "version": "0.1.0",
  "description": "Assertions and Vitest/Jest matchers for running Trinker security scans inside your test suite.",
  "license": "MIT",
  "author": "Paardhu22",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Paardhu22/trinker.git",
    "directory": "packages/vitest"
  },
  "homepage": "https://github.com/Paardhu22/trinker/tree/main/packages/vitest#readme",
  "bugs": {
    "url": "https://github.com/Paardhu22/trinker/issues"
  },
  "keywords": [
    "security",
    "appsec",
    "api-security",
    "deterministic",
    "trinker",
    "vitest",
    "jest",
    "testing"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./setup": {
      "types": "./dist/setup.d.ts",
      "import": "./dist/setup.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup --clean src/index.ts src/setup.ts --format esm --dts --external vitest",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@trinker/core": "workspace:*"
  },
  "peerDependencies": {
    "vitest": ">=2"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
