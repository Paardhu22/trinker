{
  "name": "trinker",
  "version": "0.1.1",
  "description": "Deterministic application security testing: compile a reviewable plan once, replay it on every scan with zero runtime LLM tokens.",
  "license": "MIT",
  "author": "Paardhu22",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Paardhu22/trinker.git",
    "directory": "packages/trinker"
  },
  "homepage": "https://github.com/Paardhu22/trinker/tree/main/packages/trinker#readme",
  "bugs": {
    "url": "https://github.com/Paardhu22/trinker/issues"
  },
  "keywords": [
    "security",
    "appsec",
    "api-security",
    "deterministic",
    "trinker",
    "cli",
    "bola",
    "api-security",
    "dast"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "bin": {
    "trinker": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup --clean src/index.ts src/cli.ts --format esm --dts",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "prepack": "cp ../../README.md README.md"
  },
  "dependencies": {
    "@trinker_vul/compiler": "workspace:*",
    "@trinker_vul/core": "workspace:*",
    "@trinker_vul/oracles": "workspace:*",
    "@trinker_vul/report": "workspace:*",
    "@trinker_vul/surface": "workspace:*",
    "yaml": "^2.9.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
