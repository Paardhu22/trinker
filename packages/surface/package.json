{
  "name": "@trinker_vul/surface",
  "version": "0.1.0",
  "description": "Trinker surface discovery: Express/Fastify route extraction, OpenAPI (JSON/YAML), and HAR ingestion.",
  "license": "MIT",
  "author": "Paardhu22",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Paardhu22/trinker.git",
    "directory": "packages/surface"
  },
  "homepage": "https://github.com/Paardhu22/trinker/tree/main/packages/surface#readme",
  "bugs": {
    "url": "https://github.com/Paardhu22/trinker/issues"
  },
  "keywords": [
    "security",
    "appsec",
    "api-security",
    "deterministic",
    "trinker",
    "express",
    "fastify",
    "openapi",
    "har"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup --clean src/index.ts --format esm --dts",
